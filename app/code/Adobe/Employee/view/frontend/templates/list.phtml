<h2>My Employees</h2>

<a href="<?= $block->escapeUrl($block->getUrl('employee/account/add')) ?>"
   style="margin-bottom:10px; display:inline-block;">Add Employee</a>

<table border="1" cellpadding="5" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <thead>
        <tr>
            <th>Name</th>
            <th>Joining Date</th>
            <th>Designation</th>
            <th>Address</th>
            <th>Status</th>
            <th>Hobbies</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

    <?php $employees = $block->getEmployees(); ?>

    <?php if ($employees && count($employees)): ?>
        <?php foreach ($employees as $emp): ?>
            <tr>
                <td><?= $block->escapeHtml($emp->getName()) ?></td>
                <td><?= $block->escapeHtml($emp->getJoiningDate()) ?></td>
                <td><?= $block->escapeHtml($emp->getDesignation()) ?></td>
                <td><?= $block->escapeHtml($emp->getAddress()) ?></td>
                <td><?= $emp->getStatus() ? 'Active' : 'Inactive' ?></td>
                <td><?= $block->escapeHtml($emp->getHobbies()) ?></td>
                <td>
                    <a href="<?= $block->escapeUrl($block->getUrl('employee/account/edit', ['id'=>$emp->getId()])) ?>">Edit</a> |
                    <a href="<?= $block->escapeUrl($block->getUrl('employee/account/delete', ['id'=>$emp->getId()])) ?>"
                       onclick="return confirm('Are you sure you want to delete this employee?')">Delete</a>
                </td>
            </tr>
        <?php endforeach; ?>
    <?php else: ?>
        <tr>
            <td colspan="7">No employees found.</td>
        </tr>
    <?php endif; ?>

    </tbody>
</table>