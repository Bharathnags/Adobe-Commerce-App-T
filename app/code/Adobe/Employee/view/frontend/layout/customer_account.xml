<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="customer_account_navigation">

            <!-- Normal Version -->
            <block class="Magento\Framework\View\Element\Html\Link\Current"
                   name="customer-account-navigation-employee">
                <arguments>
                    <argument name="label" xsi:type="string">My Employees</argument>
                    <argument name="path" xsi:type="string">employee/account/index</argument>
                </arguments>
            </block>

            <!-- Knockout Version -->
            <block class="Magento\Framework\View\Element\Html\Link\Current"
                   name="customer-account-navigation-employee-ko">
                <arguments>
                    <argument name="label" xsi:type="string">My Employees (KO)</argument>
                    <argument name="path" xsi:type="string">employee/account/knockout</argument>
                </arguments>
            </block>

        </referenceBlock>
    </body>
</page>